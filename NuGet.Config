<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Use a known official source for this project, independent of disabled/missing user feeds.
       This does not change the machine-wide NuGet settings. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
