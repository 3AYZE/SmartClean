<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <SmartCleanTargetFramework Condition="'$(SmartCleanTargetFramework)' == ''">net10.0</SmartCleanTargetFramework>
    <TargetFramework>$(SmartCleanTargetFramework)-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Internal assembly and XAML namespace intentionally preserved across
         the SupaClean branding migration, to minimize startup regressions. -->
    <RootNamespace>SmartClean.WinUI</RootNamespace>
    <Version>0.4.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Required for WinUI XAML / native deployment assets on some publish paths,
         even though this release remains unpackaged (WindowsPackageType=None). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Do not trim WinRT/XAML metadata or attempt single-file / AOT publication. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <Platforms>x64;arm64</Platforms>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationIcon>Assets\SupaClean.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="..\SmartClean.Core\SmartClean.Core.csproj" />
    <Content Include="Assets\SupaClean.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\SupaClean-Tray.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\SupaClean-Icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\SupaClean.svg" />
  </ItemGroup>
  <Target Name="GenerateSupaCleanIcons" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Generate-SupaCleanIcons.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\Assets&quot;" />
  </Target>
</Project>
