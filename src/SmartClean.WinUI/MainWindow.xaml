<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SmartClean.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SmartClean.WinUI.Models"
    Title="SupaClean">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontSize="19" Foreground="{ThemeResource SmartAccent}" />
                <TextBlock Text="SupaClean" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Preview 0.4" Foreground="{ThemeResource SmartSubtleText}"
                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left"
                        OpenPaneLength="216" CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True" PaneTitle="YOUR COMPUTER"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Applications" Tag="apps">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Files &amp; storage" Tag="folders">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Cleanup" Tag="cleanup">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Delete" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dependencies" Tag="dependencies">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Link" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Protection" Tag="safety">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="4">
                <InfoBar x:Name="UpdateInfo" Title="SupaClean update available" Severity="Informational" IsOpen="False" IsClosable="True" Margin="18,8,22,0">
                    <InfoBar.ActionButton>
                        <Button Content="Review update" Click="ReviewUpdate_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="StatusInfo" Grid.Row="0" Title="Ready to scan"
                         Message="Scanning does not change files. Optional cleanup moves only selected eligible temporary files to Recovery."
                         Severity="Informational" IsOpen="False" IsClosable="True" Margin="18,8,22,4" />
                </StackPanel>

                <!-- OVERVIEW -->
                <ScrollViewer x:Name="OverviewView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Padding="28,22,28,42" Spacing="18">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Overview" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Registered apps, storage and evidence-backed software relationships."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="CancelButton" Content="Cancel" Click="CancelScan_Click" IsEnabled="False" />
                                <Button x:Name="RefreshButton" Content="Scan computer" Click="StartScan_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing x:Name="ScanRing" IsActive="False" Width="18" Height="18" />
                            <TextBlock x:Name="ScanStatusText" Text="No scan has run yet."
                                       VerticalAlignment="Center" Foreground="{ThemeResource SmartSubtleText}" />
                        </StackPanel>
                        <Border Background="{ThemeResource SmartCardBackground}"
                                BorderBrush="{ThemeResource SmartCardStroke}" BorderThickness="1"
                                CornerRadius="12" Padding="22">
                            <StackPanel Spacing="14">
                                <TextBlock Text="System drive" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock x:Name="DiskSizeText" Text="Scan to measure available space"
                                           FontSize="26" FontWeight="SemiBold" />
                                <ProgressBar x:Name="DiskBar" Minimum="0" Maximum="100" Value="0" Height="8" />
                                <TextBlock x:Name="DiskFreeText" Text="Only fixed drives are measured."
                                           Foreground="{ThemeResource SmartSubtleText}" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Installed apps" Foreground="{ThemeResource SmartSubtleText}" />
                                    <TextBlock x:Name="AppsCount" Text="—" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="From Windows uninstall records" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{ThemeResource SmartSubtleText}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource SmartCardBackground}"
                                    BorderBrush="{ThemeResource SmartCardStroke}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Protected components" Foreground="{ThemeResource SmartSubtleText}" />
                                    <TextBlock x:Name="ProtectedCount" Text="—" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="Known shared runtimes and safeguards" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{ThemeResource SmartSubtleText}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource SmartCardBackground}"
                                    BorderBrush="{ThemeResource SmartCardStroke}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Observed dependency references" Foreground="{ThemeResource SmartSubtleText}" />
                                    <TextBlock x:Name="DependencyCount" Text="—" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="Bounded .NET configs, native imports and package references" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{ThemeResource SmartSubtleText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Storage findings" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock x:Name="StorageSummary" Text="Downloads and the temporary folder will be measured."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Measured size is not the same as reclaimable space. This preview makes no deletion recommendations based only on file age."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- APPLICATIONS -->
                <Grid x:Name="AppsView" Grid.Row="1" Visibility="Collapsed" Padding="28,22,28,24" ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" RowSpacing="13">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Applications" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="AppListSubtitle" Text="Scan to inspect registered applications."
                                       Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox x:Name="AppsSearch" Grid.Row="1" Header="Search installed apps" PlaceholderText="Name or publisher"
                                 TextChanged="AppsSearch_TextChanged" />
                        <ListView x:Name="AppList" Grid.Row="2" SelectionMode="Single"
                                  SelectionChanged="AppList_SelectionChanged" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AppRow">
                                    <Grid Padding="5,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource SmartSubtleText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                            <TextBlock Text="{x:Bind Size}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind Badge}" FontSize="12" Foreground="{ThemeResource SmartSubtleText}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Selected application" Foreground="{ThemeResource SmartSubtleText}" />
                                <TextBlock x:Name="DetailName" Text="Choose an application" FontWeight="SemiBold"
                                           FontSize="20" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailPublisher" Text="View its available installation and dependency evidence."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <Rectangle Height="1" Fill="{ThemeResource SmartCardStroke}" Margin="0,4" />
                                <TextBlock Text="Protection status" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailProtection" Text="No item selected." TextWrapping="Wrap" />
                                <TextBlock Text="Observed dependency evidence" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock x:Name="DetailDependencies" Text="Select an item to inspect its evidence."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Install location" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock x:Name="DetailLocation" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <Rectangle Height="1" Fill="{ThemeResource SmartCardStroke}" Margin="0,4" />
                                <TextBlock Text="Removal options" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailRemovalStatus" Text="Select an application to see available uninstall methods."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="MsiUninstallButton" Content="Uninstall app"
                                            Click="MsiUninstall_Click" IsEnabled="False"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="OpenWindowsUninstallButton" Content="Windows Installed apps"
                                            Click="OpenWindowsUninstall_Click" IsEnabled="False" />
                                    <Button x:Name="OpenInstallFolderButton" Content="Open install folder"
                                            Click="OpenInstallFolder_Click" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock Text="SupaClean never deletes an application folder directly. Direct uninstall is offered only for a validated MSI product code; other apps are handed to Windows."
                                           Foreground="{ThemeResource SmartSubtleText}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="Important: a native import or package reference may be bundled. Missing evidence does not prove that an app has no dependencies."
                                           Foreground="{ThemeResource SmartSubtleText}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- FILES AND STORAGE -->
                <ScrollViewer x:Name="FoldersView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Padding="28,22,28,42" Spacing="16">
                        <TextBlock Text="Files &amp; storage" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Measure known folders without opening, moving or deleting their contents. Linked folders are skipped."
                                   Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource SmartCardBackground}"
                                BorderBrush="{ThemeResource SmartCardStroke}" BorderThickness="1"
                                CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Choose drives to inspect" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Select C:, D:, additional fixed drives, or All fixed drives. This measures storage only. It never adds drive files to the cleanup deletion list."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <CheckBox x:Name="AllDrivesCheckBox" Content="All fixed drives"
                                          Checked="AllDrives_Changed" Unchecked="AllDrives_Changed" />
                                <StackPanel x:Name="DriveChoicesPanel" Spacing="5" />
                                <TextBlock x:Name="SelectedDriveSummary" Text="Loading available local drives..."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ScanSelectedDrivesButton" Content="Scan selected drives"
                                            Click="ScanSelectedDrives_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Refresh drive list" Click="RefreshDrives_Click" />
                                </StackPanel>
                                <TextBlock Text="Each drive has a scan entry limit. An incomplete scan is marked partial; symbolic links and junctions are never followed. Network and removable drives are excluded."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ListView x:Name="FolderList" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FolderRow">
                                    <Border BorderBrush="{ThemeResource SmartCardStroke}" BorderThickness="1"
                                            Background="{ThemeResource SmartCardBackground}" CornerRadius="10" Padding="18" Margin="0,5,0,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Path}" Foreground="{ThemeResource SmartSubtleText}"
                                                           TextWrapping="Wrap" FontSize="12" />
                                                <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource SmartSubtleText}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                                                <TextBlock Text="{x:Bind Size}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind Flag}" Foreground="{ThemeResource SmartSubtleText}" FontSize="12" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="How to interpret the findings" FontWeight="SemiBold" />
                                <TextBlock Text="Downloads contain personal files, even when old. Temporary folders may include files still in use. Folder totals are estimates; review eligible individual temporary files separately in Cleanup."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- REVIEWED TEMPORARY-FILE CLEANUP -->
                <ScrollViewer x:Name="CleanupView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel MaxWidth="1010" HorizontalAlignment="Stretch" Padding="28,22,28,42" Spacing="16">
                        <TextBlock Text="Cleanup" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Inspect the files SupaClean found, choose exactly what to keep or move, and review the list again before making changes. Nothing is selected or deleted automatically."
                                   TextWrapping="Wrap" Foreground="{ThemeResource SmartSubtleText}" />
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="13">
                                <TextBlock Text="Eligible temporary files" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Only regular .tmp, .temp, .log and .dmp files directly inside your temporary folder, unchanged for at least 30 days, can be moved to Recovery."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CleanupSummary" Text="Scan to view eligible files, their sizes and why other files are excluded."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <TextBlock Text="Check the files you want to review. Keeping everything unselected is always allowed."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <ListView x:Name="TempCandidateList" SelectionMode="Multiple" MaxHeight="360"
                                          SelectionChanged="TempCandidateList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TempCandidateRow">
                                            <Grid ColumnSpacing="14" Padding="3,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource SmartSubtleText}" FontSize="12" />
                                                    <TextBlock Text="{x:Bind Location}" Foreground="{ThemeResource SmartSubtleText}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Size}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="CandidateSelectionSummary" Text="Selected: 0 files · 0 B" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="CleanupRefreshButton" Content="Rescan" Click="CleanupRefresh_Click" />
                                    <Button x:Name="MoveTempButton" Content="Review selected files" IsEnabled="False"
                                            Click="MoveTemp_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <TextBlock Text="Moving files to Recovery is reversible but does NOT free storage. You can permanently delete individual Recovery files after a second review."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Excluded files (read-only)" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="ExcludedReasonSummary" Text="Scan to see why files were not eligible. Excluded files cannot be selected for cleanup."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <ListView x:Name="ExcludedTempList" SelectionMode="None" MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TempExcludedRow">
                                            <Grid ColumnSpacing="14" Padding="3,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Reason}" FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Location}" FontSize="11" Foreground="{ThemeResource SmartSubtleText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Size}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Only the current folder's top-level files are inspected. Nested app folders, Downloads and shared components are never offered for deletion here."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="13">
                                <TextBlock Text="Recovery — final deletion list" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="RecoverySummary" Text="Files moved into Recovery appear here. Select individual files to restore or permanently delete."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <ListView x:Name="RecoveryList" SelectionMode="Multiple" MaxHeight="320"
                                          SelectionChanged="RecoveryList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RecoveryRow">
                                            <StackPanel Spacing="4" Padding="3,7">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource SmartSubtleText}" />
                                                <TextBlock Text="{x:Bind OriginalPath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource SmartSubtleText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="RecoverySelectionSummary" Text="Selected: 0 recovery files · 0 B" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="RestoreButton" Content="Restore selected" IsEnabled="False" Click="Restore_Click" />
                                    <Button x:Name="PurgeButton" Content="Review selected for permanent deletion" IsEnabled="False"
                                            Click="Purge_Click" />
                                </StackPanel>
                                <TextBlock Text="Permanent deletion affects ONLY the files you choose in Recovery. A second review lists every filename, size and original path; you can deselect items or cancel."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- DEPENDENCY RELATIONSHIPS: Evidence, not removal authorization -->
                <ScrollViewer x:Name="DependenciesView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel MaxWidth="970" HorizontalAlignment="Stretch" Padding="28,22,28,42" Spacing="16">
                        <TextBlock Text="Dependencies" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Separate Windows service associations, shared runtime references and components with no detected dependents. Unknown use stays protected."
                                   Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Windows and background services" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Shows which registered Windows services use executables from Windows directories or installed application folders. This does not prove those services need a particular runtime."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ServiceSummary" Text="Run a scan to inspect available Windows service registrations." Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap"/>
                                <ComboBox x:Name="ServiceFilter" Header="Show services" SelectionChanged="ServiceFilter_SelectionChanged"
                                          SelectedIndex="0" MinWidth="240">
                                    <ComboBoxItem Content="All observed services" />
                                    <ComboBoxItem Content="Executable in Windows folder" />
                                    <ComboBoxItem Content="Associated with installed apps" />
                                    <ComboBoxItem Content="Unassociated" />
                                </ComboBox>
                                <ListView x:Name="ServiceList" MaxHeight="260" SelectionMode="Single"
                                          SelectionChanged="ServiceList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ServiceRelationshipRow">
                                            <StackPanel Spacing="3" Padding="3,5">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Category}" Foreground="{ThemeResource SmartSubtleText}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource SmartSubtleText}" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="ServiceDetails" Text="Select a service to see its executable path and associated registered application, if identified."
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Other shared components and applications" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Visual C++, WebView2, Windows App SDK, Java, Python, Vulkan and legacy DirectX. Select a component to see app names and native-import or package evidence."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="OtherComponentSummary" Text="Run a scan to inventory recognized components and read bounded application imports."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <ListView x:Name="OtherComponentList" SelectionMode="Single" MaxHeight="340"
                                          SelectionChanged="OtherComponentList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SharedComponentRow">
                                            <StackPanel Spacing="3" Padding="3,5">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Family}" FontSize="12"
                                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Summary}" FontSize="12"
                                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Observed application references" FontWeight="SemiBold" />
                                <TextBlock x:Name="OtherComponentDetails" Text="Select a component to inspect matching applications and the exact files supporting each relationship."
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <TextBlock Text="Native imports and managed package references indicate possible use, not proof that a separately installed redistributable supplied the library. An empty result never authorizes removal."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Select a shared component for its installer parts, app references and supporting evidence." Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap"/>
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Installed .NET runtimes and their applications" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="For example, Microsoft .NET Runtime 9 shows applications whose runtimeconfig files request the .NET 9 runtime family. A declaration does not prove which exact patch was actually loaded."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="RuntimeSummary" Text="Run a scan to inspect registered .NET runtimes and recorded app requirements."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <ListView x:Name="RuntimeList" SelectionMode="Single" MaxHeight="290"
                                          SelectionChanged="RuntimeList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RuntimeUsageRow">
                                            <StackPanel Spacing="3" Padding="3,5">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Framework}" FontSize="12"
                                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Summary}" FontSize="12"
                                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Matching application declarations" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuntimeDetails" Text="Select a runtime above to see which detected apps declare it and the exact file supporting each relationship."
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <TextBlock Text="No detected dependents never means safe to uninstall. Portable apps, native DLLs, optional paths, and runtime roll-forward remain unverified."
                                           FontSize="12" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="No detected dependents" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="These installed shared components have no matching application declarations or imports within the scan's limited coverage. They are NOT proven unused and cannot be automatically removed."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="UnreferencedSummary" Text="Scan to find shared components without observed dependents." Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap"/>
                                <ListView x:Name="UnreferencedList" MaxHeight="280" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:UnreferencedRow">
                                            <StackPanel Spacing="3" Padding="3,5">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Type}" Foreground="{ThemeResource SmartSubtleText}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Explanation}" FontSize="11" Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- PROTECTION -->
                <ScrollViewer x:Name="SafetyView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel MaxWidth="970" HorizontalAlignment="Stretch" Padding="28,22,28,42" Spacing="16">
                        <TextBlock Text="Protection" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Mandatory safeguards remain in place. Cleanup is limited to reviewed temporary-file candidates; application removal is Windows-managed."
                                   Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Protected by design" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="• Shared runtimes (.NET, Visual C++, WebView2, Java, Python, graphics, Windows App SDK) stay protected" TextWrapping="Wrap" />
                                <TextBlock Text="• Unknown or unverified dependencies: never assumed safe" TextWrapping="Wrap" />
                                <TextBlock Text="• Personal projects, Downloads and game saves: no automatic deletion" TextWrapping="Wrap" />
                                <TextBlock Text="• Directory junctions and symbolic links: not followed by the folder scan" TextWrapping="Wrap" />
                                <TextBlock Text="• App removal: Windows Settings handles uninstallation; registry commands are never executed" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>


                        <TextBlock Text="Scan limitations" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="Dependency scanning reads bounded .NET runtime declarations, selected native PE imports and managed package references within registered installation folders. Dynamic loading, bundled DLLs, optional features and portable applications may remain unobserved. File-system exclusions are listed below."
                                   TextWrapping="Wrap" />
                        <ListView x:Name="WarningsList" SelectionMode="None" IsItemClickEnabled="False" />
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel MaxWidth="850" HorizontalAlignment="Stretch" Padding="28,22,28,42" Spacing="16">
                        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Essential preferences only. Safety protections cannot be disabled."
                                   Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="17" />
                                <ComboBox x:Name="ThemePicker" Header="App theme" SelectedIndex="0" Width="240"
                                          SelectionChanged="ThemePicker_SelectionChanged">
                                    <ComboBoxItem Content="Use Windows setting" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Application updates" FontWeight="SemiBold" FontSize="17" />
                                <TextBlock x:Name="CurrentVersionText" Text="Installed version: 0.3" />
                                <TextBlock x:Name="UpdateStatusText" Text="Checking for public GitHub releases when SupaClean starts."
                                           Foreground="{ThemeResource SmartSubtleText}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" />
                                    <Button x:Name="InstallUpdateButton" Visibility="Collapsed" Content="Download and install"
                                            Click="InstallUpdate_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <ProgressBar x:Name="UpdateDownloadBar" IsIndeterminate="False" Minimum="0" Maximum="100"
                                             Value="0" Height="6" Visibility="Collapsed" />
                                <TextBlock Text="Every main-branch source update automatically produces a tested Windows installer release. SupaClean verifies its hash and requests approval before installing."
                                           FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SmartSubtleText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource SmartCardBackground}" BorderBrush="{ThemeResource SmartCardStroke}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Privacy &amp; scanning" FontWeight="SemiBold" FontSize="17" />
                                <TextBlock Text="Local only. No telemetry, advertising, account or cloud connection." TextWrapping="Wrap" />
                                <TextBlock Text="Scanning is manually initiated and reads Windows uninstall records, limited runtime declarations, your Downloads and temporary folders, and fixed-drive capacity."
                                           TextWrapping="Wrap" Foreground="{ThemeResource SmartSubtleText}" />
                                <TextBlock Text="Application usage tracking is not enabled. Age is only used to shortlist eligible temporary files, never to authorize removing programs."
                                           TextWrapping="Wrap" Foreground="{ThemeResource SmartSubtleText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
